[TEMPLATE]
# ── NEXUS environment ─────────────────────────────────────────────
# Default: PostgreSQL (start it with `docker compose up -d postgres` or point
# DATABASE_URL at your own instance). Redis is optional in development.
# For a zero-dependency local run, switch to SQLite:
#   NODE_ENV=development + DATABASE_URL=sqlite:data/nexus.sqlite
# NODE_ENV=production always uses PostgreSQL + Redis (see docker-compose.yml).
NODE_ENV=development

# ── Server ─────────────────────────────────────────────────────────
PORT=8080
API_URL=http://localhost:8080
PUBLIC_URL=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=false

# ── Database ───────────────────────────────────────────────────────
# Default (PostgreSQL — matches the docker-compose postgres service):
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
# Alternative (SQLite, local file — zero external services):
# DATABASE_URL=sqlite:data/nexus.sqlite

# ── Redis (production; optional in dev) ────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Secrets ────────────────────────────────────────────────────────
# 32+ random bytes (hex) — used to sign session cookies and derive keys.
SESSION_SECRET=change-me-32-bytes-minimum-random-hex-string
# 32 bytes hex — used to encrypt secrets at rest (env values, SSH keys, tokens).
ENCRYPTION_KEY=change-me-32-bytes-minimum-random-hex-string

# ── Agent ──────────────────────────────────────────────────────────
# Where the local NEXUS Agent connects back to the API.
AGENT_API_URL=http://localhost:8080
# Docker connection for the Agent (default: platform socket).
# DOCKER_HOST=unix:///var/run/docker.sock
# DOCKER_HOST=npipe:////./pipe/docker_engine

# ── Dashboard ──────────────────────────────────────────────────────
DASHBOARD_PORT=5173
