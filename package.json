{
  "name": "nexus",
  "private": true,
  "version": "0.1.0",
  "description": "NEXUS — self-hosted PaaS control plane (Bun + TypeScript + React)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@nexus/api --filter=@nexus/dashboard",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:agent": "AGENT_TOKEN=x AGENT_SERVER_ID=x bun run --cwd apps/agent dev",
    "dev:dashboard": "bun run --cwd apps/dashboard dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "bun run --cwd packages/database migrate"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.2.0"
  }
}
